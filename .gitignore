# Build output. Not anchored with a leading slash, so a nested workspace's
# `target/` is ignored too.
target/
**/*.rs.bk
*.pdb

# Stray build artifacts. Two 3.6 MB Linux ELF executables with debug info were
# committed at the repository root before this entry existed; both were produced
# by an ad-hoc build, referenced by nothing, and carried in every clone.
/rust_out
/tmp

# Coverage output
/coverage/
*.profraw
*.profdata
lcov.info

# Local secrets — never commit; copy .env.example to .env
.env
.env.local

# Linked worktrees created by the local `worktree` helper
worktrees/*
!worktrees/.gitkeep

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.swp
