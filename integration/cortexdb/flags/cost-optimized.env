# Composite, after the docs' Cost-Optimized profile: every optional model
# call off (graph, HyDE, multihop, polarity recheck, verifier) and enrichment
# batched per scope.
# targets: all
# docs: https://cortexdb.ai/docs/operations/profiles
CORTEX_ENTITY_GRAPH=0
CORTEX_HYDE_PASSAGES_MS=0
CORTEX_MULTIHOP_QUERY_PLANNER_DISABLE=1
CORTEX_POLARITY_RECHECK=0
CORTEX_VERIFIER_API_KEY=
CORTEX_FALLBACK_KEY=
CORTEX_ENRICHMENT_SCOPE_QUIET_MS=5000
