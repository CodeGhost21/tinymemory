# No verifier pass over generated answers. v0.10.4 ignores an empty
# CORTEX_VERIFIER_URL (the docs say it disables the lane) and turns the
# verifier on whenever OPENAI_API_KEY or CORTEX_VERIFIER_API_KEY is set, so
# both are emptied (CORTEX_FALLBACK_KEY feeds OPENAI_API_KEY in the compose
# file). No other lane reads them here: each has its own key.
# targets: cost, accuracy
# docs: https://cortexdb.ai/docs/operations/llm-answer
CORTEX_VERIFIER_API_KEY=
CORTEX_FALLBACK_KEY=
